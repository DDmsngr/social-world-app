# Self-hosted Supabase на Yandex Cloud (см. supabase/README.md).
# Пока сервер не поднят — оставьте пустыми, приложение запустится на заглушках.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Яндекс MapKit — понадобится с фазы 2.
# Важно: ключ нужен именно для сервиса "MapKit Mobile SDK" на
# https://developer.tech.yandex.ru/services/ — ключ от "JavaScript API и
# HTTP Геокодера" или обычный Yandex Cloud API-ключ выглядит так же (UUID),
# но карта с ним инициализируется без ошибок и просто не грузит тайлы
# (видна серая сетка вместо карты).
YANDEX_MAPKIT_API_KEY=
