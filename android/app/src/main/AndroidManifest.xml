<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Запись маршрута идёт только при открытом приложении: фоновой службы
         нет, поэтому ACCESS_BACKGROUND_LOCATION намеренно не запрашиваем. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Трансляция геопозиции в чате (0060) идёт и при свёрнутом приложении:
         служба геолокатора с уведомлением «ChaWo транслирует геопозицию».
         Служба стартует из открытого приложения, поэтому фонового доступа к
         геолокации по-прежнему не нужно. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Фото-метки на маршруте снимаются камерой прямо во время прогулки. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Голосовые и звук кружков в чатах. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Звонки (flutter_webrtc): динамик/наушник, гарнитура, смена сети
         посреди разговора. Звонилка (flutter_callkit_incoming) свои
         разрешения — полноэкранный входящий, службу звонка — приносит сама. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Приложение раздаётся APK мимо Google Play, поэтому обновляет себя само:
         скачивает новый файл и отдаёт его системному установщику. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Push-уведомления (FCM). На Android 13+ разрешение спрашивается при
         первом запуске после входа. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Сохранить в галерею» из чата. С Android 10 запись в общую галерею
         разрешения не требует, ниже — только так. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Приглашение друзей: показать, кто из записной книжки уже в ChaWo. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <application
        android:label="ChaWo"
        android:name=".MainApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask без пустого taskAffinity: тап по пушу, ссылка или
             возврат из браузера после входа попадают в уже открытое приложение.
             Со стоковым шаблоном Flutter (singleTop + taskAffinity="") каждый
             такой вход открывал вторую копию ChaWo в списке недавних. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Ссылки разбирает приложение само (app_links, lib/core/links), а
                 не встроенный диплинк Flutter: тот пытался бы открыть путь
                 ссылки как экран роутера. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- socialworld://auth-callback — редирект из моста входа (VK ID/Яндекс ID,
                 lib/core/oauth); socialworld://post|event|place|profile|route/<id> —
                 ссылки на объекты (lib/core/links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="socialworld"/>
            </intent-filter>
            <!-- Веб-ссылки, которыми делятся (DeepLinks.shareBase). Без autoVerify:
                 подтверждённые ссылки требуют assetlinks.json на домене — это
                 инфраструктура, которой у проекта пока нет. Пока Android
                 предложит выбрать «Открыть в ChaWo». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="ddmsngr.github.io" android:pathPrefix="/social-world/o"/>
            </intent-filter>
            <!-- Личные приглашения https://api-socialworld.deepdrift.tech/r/<код>:
                 стоит приложение — открывается сразу в нём, нет — страница
                 с кнопкой «Скачать». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="api-socialworld.deepdrift.tech" android:pathPrefix="/r/"/>
            </intent-filter>
            <!-- «Поделиться» из других приложений: текст и ссылки, фото, видео,
                 любые файлы. ChaWo появляется в системном списке, дальше
                 приложение само предлагает выбрать чат (lib/core/share). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
                <data android:mimeType="video/*"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <action android:name="android.intent.action.SEND_MULTIPLE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/*"/>
                <data android:mimeType="audio/*"/>
            </intent-filter>
        </activity>
        <!-- Пуши, пришедшие в фоне, рисует система: ей нужны монохромная иконка
             и канал по умолчанию (каналы создаёт приложение, lib/core/push). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="activity" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- «Пригласить» из контактов открывает SMS с готовым текстом. -->
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="sms"/>
        </intent>
    </queries>
</manifest>
