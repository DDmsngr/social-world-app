<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Запись маршрута идёт только при открытом приложении: фоновой службы
         нет, поэтому ACCESS_BACKGROUND_LOCATION намеренно не запрашиваем. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Фото-метки на маршруте снимаются камерой прямо во время прогулки. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Приложение раздаётся APK мимо Google Play, поэтому обновляет себя само:
         скачивает новый файл и отдаёт его системному установщику. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application
        android:label="ChaWo"
        android:name=".MainApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Ссылки разбирает приложение само (app_links, lib/core/links), а
                 не встроенный диплинк Flutter: тот пытался бы открыть путь
                 ссылки как экран роутера. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="false"/>
            <!-- socialworld://auth-callback — редирект из моста входа (VK ID/Яндекс ID,
                 lib/core/oauth); socialworld://post|event|place|profile|route/<id> —
                 ссылки на объекты (lib/core/links). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="socialworld"/>
            </intent-filter>
            <!-- Веб-ссылки, которыми делятся (DeepLinks.shareBase). Без autoVerify:
                 подтверждённые ссылки требуют assetlinks.json на домене — это
                 инфраструктура, которой у проекта пока нет. Пока Android
                 предложит выбрать «Открыть в ChaWo». -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="ddmsngr.github.io" android:pathPrefix="/social-world/o"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
